{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://portfolio-web-app-backend.onrender.com/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://portfolio-web-app-backend.onrender.com/media/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
